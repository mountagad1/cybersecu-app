# Généré par `pnpm env:example` depuis src/lib/env/registry.ts.
# Ne pas éditer à la main : modifiez le registre, puis régénérez.
#
# Chaque variable a UN nom canonique. Les alias listés restent acceptés pour
# ne pas casser un environnement déjà déployé ; un nouvel environnement ne
# doit définir que le nom canonique.
#
# Aucune de ces variables n'est préfixée NEXT_PUBLIC_ : elles sont lues côté
# serveur uniquement, donc aucune valeur n'atteint le bundle navigateur.

# ==========================================================================
# LECTURES PUBLIQUES — requis pour que le site rende quoi que ce soit
# ==========================================================================

# Origine du projet Supabase. Sans elle, chaque rendu serveur de /attaques
# et /simulations lève « Missing SUPABASE_URL » et renvoie 500.
# Alias acceptés (hérités) : NEXT_PUBLIC_SUPABASE_URL
# REQUIS
SUPABASE_URL=https://votre-projet.supabase.co

# Clé liée aux policies RLS, utilisée pour toutes les lectures publiques.
# Supabase l'appelle désormais « publishable » (sb_publishable_…) ; les
# projets antérieurs au renommage fournissent un JWT sous le nom
# SUPABASE_ANON_KEY, toujours accepté.
# Alias acceptés (hérités) : SUPABASE_ANON_KEY,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY
# REQUIS
SUPABASE_PUBLISHABLE_KEY=

# Origine publique : canonicals, OpenGraph, sitemap, JSON-LD, URLs de
# redirection Stripe. Non requise mais à définir par environnement : elle
# retombe silencieusement sur l'origine de production
# (https://www.cybersecu.app, l'hôte canonique — l'apex y redirige), donc un
# déploiement de préversion qui l'omet émet des canonicals et des
# redirections de production.
# Alias acceptés (hérités) : NEXT_PUBLIC_SITE_URL
# Optionnel
SITE_URL=https://www.cybersecu.app

# ==========================================================================
# ÉCRITURES — requis pour jouer une simulation (les lectures marchent sans)
# ==========================================================================

# Contourne RLS. Strictement serveur — ne jamais préfixer NEXT_PUBLIC_. Sans
# elle les lectures publiques fonctionnent mais toute écriture échoue :
# démarrer une simulation, la corriger, consommer le quota.
# SECRET — ne jamais committer de valeur réelle.
# REQUIS
SUPABASE_SERVICE_ROLE_KEY=

# Secret HMAC signant le cookie de session anonyme. Sa rotation invalide
# tous les cookies existants (les lignes en base sont intactes) : à traiter
# comme un changement cassant. Générer avec `openssl rand -base64 32`.
# SECRET — ne jamais committer de valeur réelle.
# REQUIS
ANON_SESSION_SECRET=

# ==========================================================================
# PAIEMENT — sans ces variables, /api/checkout répond 503
# ==========================================================================

# Clé serveur Stripe. Utilisée par /api/webhooks/stripe pour vérifier la
# signature des événements entrants (l'achat lui-même passe par un Stripe
# Payment Link géré depuis le Dashboard, pas par un appel API de création de
# session — src/lib/paymentLink.ts). Sans elle, la vérification de signature
# échoue et le webhook rejette tout événement.
# SECRET — ne jamais committer de valeur réelle.
# Optionnel
STRIPE_SECRET_KEY=

# Secret de signature du webhook Stripe. C'est le seul chemin qui accorde un
# droit d'accès : sans lui, /api/checkout répond 503 (aucun paiement ne
# pourrait jamais être converti en entitlement) et aucun événement webhook
# n'est traité.
# SECRET — ne jamais committer de valeur réelle.
# Optionnel
STRIPE_WEBHOOK_SECRET=

# URL du Stripe Payment Link derrière /api/checkout
# (src/lib/paymentLink.ts). Retombe sur le lien de production codé en dur si
# absente — à définir explicitement sur toute préversion/staging configurée
# avec des clés Stripe de test, sinon ce déploiement redirige vers le lien
# de PRODUCTION en mode live et facture de l'argent réel.
# Optionnel
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/xxxxxxxxxxxxxxxxxxxxxxx

# ==========================================================================
# EMAIL — restauration d'accès uniquement
# ==========================================================================

# Envoi de l'email de restauration d'accès. Sans elle la logique de jeton
# fonctionne mais l'envoi échoue explicitement.
# SECRET — ne jamais committer de valeur réelle.
# Optionnel
RESEND_API_KEY=

# Expéditeur de l'email de restauration.
# Optionnel
RESEND_FROM_EMAIL=cybersecu.app <noreply@cybersecu.app>

# ==========================================================================
# SIMULATIONS VOCALES — optionnel, dégrade vers la simulation texte (docs/decisions/0008)
# ==========================================================================

# Clé d'organisation Dograh (docs/decisions/0008), utilisée uniquement côté
# serveur pour créer/rafraîchir les jetons d'intégration (« embed token »)
# par scénario vocal. Sans elle, chaque page de simulation vocale répond 503
# et propose la simulation texte équivalente — le reste du site n'est pas
# affecté.
# SECRET — ne jamais committer de valeur réelle.
# Optionnel
DOGRAH_API_KEY=

# Origine de l'instance Dograh à interroger. https://app.dograh.com pour le
# cloud managé ; l'origine de votre propre déploiement en auto-hébergement.
# Optionnel
DOGRAH_BASE_URL=https://app.dograh.com

# ==========================================================================
# OUTILLAGE — migrations et seeds, jamais lu par l'application au runtime
# ==========================================================================

# Chaîne psql, utilisée uniquement par les migrations et les seeds. Jamais
# lue par l'application au runtime.
# SECRET — ne jamais committer de valeur réelle.
# Optionnel
SUPABASE_DB_URL=
